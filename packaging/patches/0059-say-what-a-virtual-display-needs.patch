From: Mirdispo contributors
Subject: Say what a virtual display needs

Sharing a virtual display has never worked here, and it fails in the worst
way it could: the desktop agrees to it, hands back a stream, and that stream
never carries a frame. A cast asked to share one sits there looking like a
cast that is about to start, for as long as anybody is willing to wait.

Nothing on this side can make the screen that is missing. A separate program
makes it, and whether that program is installed is the whole difference
between a cast that could work and one that cannot. So a cast that is asked
to share a virtual display now looks for it, and if it is not there, says so
in a sentence a person can act on.

The name of the program is the part that holds still. Which package carries
it does not: it is krfb on Debian and on Ubuntu, and elsewhere it is split
and named by whoever packaged it. The sentence therefore names the program
and offers the package as the likely answer rather than the only one, and
leaves installing it to whoever reads it. Where it was looked for goes to
the journal instead, because a program that is installed and still not found
has a path problem and nothing else would say so.

It travels as a notice of its own rather than as a state, because the state
is an enumeration the client matches on, and a sentence put there would be
matched against and found to be no state at all. The notice is empty until
there is something to read, which is how a client that has one but nothing
to show it knows to show nothing.

Making the display is the next thing, and it belongs where the decision to
make one is taken, once there is a way of telling a stream that will never
carry a frame from one that is merely slow to start. Until then a cast asked
to share a virtual display does exactly what it did before, and now says why
it appears to be doing nothing.

diff -ruN a/src/stream/nd-stream.c b/src/stream/nd-stream.c
--- a/src/stream/nd-stream.c
+++ b/src/stream/nd-stream.c
@@ -52,6 +52,7 @@
   NdSink                *sink;
   GSimpleAction         *state_action;
   GSimpleAction         *picture_action;
+  GSimpleAction         *notice_action;
   GSimpleAction         *report_action;
   GSimpleAction         *figures_action;
   guint                  report_source_id;
@@ -111,6 +112,47 @@
     }
 }
 
+/* Sharing a virtual display means asking the desktop for a screen that is
+ * not there until something makes one. Nothing on this side can make one,
+ * and the desktop will not: it hands back a stream that never carries a
+ * frame. What makes one is a separate program, and the name of that program
+ * is the part that holds still. Which package carries it does not: it is
+ * krfb on Debian and on Ubuntu, and elsewhere it is split and named by
+ * whoever packaged it. So the name is said plainly and the package is
+ * offered as the likely answer rather than the only one.
+ *
+ * Saying this is all that happens here. Making the display is the next thing
+ * and belongs where the decision to make one is taken, once there is a way
+ * of telling a stream that never carries a frame from one that is merely
+ * slow to start. Until then a cast asked to share a virtual display does
+ * what it did before, and now says why it is doing nothing. */
+#define ND_STREAM_VIRTUAL_MONITOR "krfb-virtualmonitor"
+
+static void
+nd_stream_say_what_a_virtual_display_needs (NdStream *self)
+{
+  g_autofree gchar *found = g_find_program_in_path (ND_STREAM_VIRTUAL_MONITOR);
+
+  if (found)
+    {
+      g_message ("NdStream: A virtual display can be made with %s", found);
+      return;
+    }
+
+  /* The journal gets where it was looked for, because a program that is
+   * installed and still not found has a path problem and nothing else will
+   * say so. What a person reads says none of that. */
+  g_message ("NdStream: %s was not found while looking through %s",
+             ND_STREAM_VIRTUAL_MONITOR,
+             g_getenv ("PATH") ? g_getenv ("PATH") : "an unset PATH");
+
+  if (self->notice_action)
+    g_simple_action_set_state (self->notice_action,
+                               g_variant_new_string ("Virtual display needs krfb-virtualmonitor, which was not found. "
+                                                     "On Debian/Ubuntu it ships in the krfb package; other distributions "
+                                                     "may name it differently."));
+}
+
 static GstElement *
 nd_stream_get_source (NdStream *self)
 {
@@ -143,8 +185,12 @@
     {
     case ND_SCREEN_CAST_SOURCE_TYPE_MONITOR:
     case ND_SCREEN_CAST_SOURCE_TYPE_WINDOW:
+      self->screencast_type = screencast_type;
+      break;
+
     case ND_SCREEN_CAST_SOURCE_TYPE_VIRTUAL:
       self->screencast_type = screencast_type;
+      nd_stream_say_what_a_virtual_display_needs (self);
       break;
 
     default:
@@ -454,6 +500,15 @@
                                                        g_variant_new_string (""));
   g_action_map_add_action (G_ACTION_MAP (app), G_ACTION (self->picture_action));
 
+  /* Something a person needs to read, in their words rather than ours, and
+   * empty whenever there is nothing of the sort to say. It sits beside the
+   * state rather than inside it because the state is an enumeration the
+   * client matches on, and a sentence put there would be matched against
+   * and found to be no state at all. */
+  self->notice_action = g_simple_action_new_stateful ("notice", NULL,
+                                                      g_variant_new_string (""));
+  g_action_map_add_action (G_ACTION_MAP (app), G_ACTION (self->notice_action));
+
   /* Said by whoever is reading them, so that nothing is totalled and nothing
    * is sent while the figures are folded away. */
   self->report_action = g_simple_action_new_stateful ("report", G_VARIANT_TYPE_BOOLEAN,
